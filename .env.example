# Database (Supabase PostgreSQL — copy exact strings from Project Settings → Database)
# Session pooler (5432) for migrations / DIRECT_URL
# Transaction pooler (6543) for app runtime / DATABASE_URL
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-1-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-1-[region].pooler.supabase.com:5432/postgres"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Opzionale: Price ID creato in Stripe Dashboard (Products → AgencyFlow Pro → €49/mese)
# Se omesso, il checkout usa un prezzo dinamico
STRIPE_PRICE_ID="price_..."

# OpenRouter (https://openrouter.ai/keys) — agenti AI
OPENROUTER_API_KEY="sk-or-..."
# Usa un modello chat standard (NO modelli :free reasoning-only tipo poolside/laguna)
OPENROUTER_MODEL="openai/gpt-4o-mini"
# Modello dedicato al parser import (opzionale)
OPENROUTER_PARSER_MODEL="openai/gpt-4o-mini"

# Opzionale: proxy lettura pagine protette (Immobiliare, Idealista) — https://jina.ai/reader
JINA_API_KEY="jina_..."
